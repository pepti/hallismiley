{
  "name": "orangesmiley",
  "version": "0.1.0",
  "description": "Orange Smiley — built on the HalliProjects base",
  "main": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "migrate": "node server/scripts/migrate.js",
    "bootstrap": "node server/scripts/bootstrap.js",
    "seed": "node server/scripts/seed.js",
    "seed:arnarhraun": "node server/scripts/seed-arnarhraun.js",
    "import:csv": "node server/scripts/import-products-csv.js",
    "market:import": "node server/scripts/market-import.js",
    "leads:export": "node server/scripts/leads-export.js",
    "leads:import": "node server/scripts/leads-import.js",
    "publish:sellers": "node server/scripts/publish-sellers.js",
    "books:fx": "node server/scripts/books-fetch-fx.js",
    "test": "jest",
    "test:unit": "jest -c jest.unit.config.js",
    "test:smoke": "jest tests/integration/auth.test.js tests/integration/security.test.js tests/integration/shop.test.js tests/integration/contact.test.js",
    "test:hotfix": "npm run test:unit && npm run test:smoke",
    "test:related": "jest --findRelatedTests --passWithNoTests",
    "test:ci": "node --max-old-space-size=8192 node_modules/jest/bin/jest.js --ci --forceExit --coverage",
    "test:db:clean": "node scripts/drop-test-dbs.js",
    "test:pg:init": "node scripts/test-pg.js init",
    "test:pg:start": "node scripts/test-pg.js start",
    "test:pg:status": "node scripts/test-pg.js status",
    "test:pg:stop": "node scripts/test-pg.js stop",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/auth.spec.js e2e/navigation.spec.js e2e/business-routes.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n-keys.js",
    "prepare": "husky || true",
    "seed:books": "node server/scripts/seed-books-demo.js",
    "books:archive": "node server/scripts/books-archive-export.js",
    "books:backfill": "node server/scripts/books-backfill-orders.js",
    "books:replay": "node server/scripts/books-replay.js",
    "dev:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-server.ps1 -Action start",
    "dev:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-server.ps1 -Action stop",
    "dev:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-server.ps1 -Action status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@lucia-auth/adapter-postgresql": "^3.1.2",
    "@sentry/node": "^10.69.0",
    "applicationinsights": "2.9.8",
    "archiver": "^7.0.1",
    "arctic": "^3.7.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "lucia": "^3.2.2",
    "multer": "^2.2.0",
    "oslo": "^1.2.1",
    "pdf-parse": "2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode-generator": "^2.0.4",
    "resend": "^6.18.1",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "babel-jest": "^30.3.0",
    "chart.js": "^4.5.1",
    "eslint": "^10.8.0",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "^30.4.2",
    "js-yaml": "3.15.2",
    "nodemon": "^3.1.0",
    "pdf-lib": "1.17.1",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "^3.3.18",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
