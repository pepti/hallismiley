# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example

# Keys and secrets
keys/
ClaudeHalliProjectskeys/
*.pem
*.key
*.p12
*.pfx

# Data / database files
data/

# Claude IDE files
.claude/*
# …except the engine-canonical rules and commands (D-021): tracked here and
# received by every downstream through `git merge upstream/master`. Worktrees,
# settings and per-machine files under .claude/ stay ignored.
!.claude/rules/
!.claude/commands/
.claude.zip

# Codex CLI local tooling (hooks reference local .claude/ scripts)
.codex/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Build identity — stamped into the image at build time by
# scripts/generate-version.js, never committed (a committed stamp would lie
# the moment anyone edited code without rebuilding).
server/version.json
# Same rule for the recent-changes stamp (server/scripts/generate-changes.js):
# written on the build host right before docker build, never committed.
server/changes.json

# Build output
dist/
build/

# Test coverage reports (generated, not committed)
coverage/

# Playwright / test runner artifacts
playwright-report/
test-results/

# Runtime uploads — local-disk fallback for the upload paths that hit Azure
# blob storage in production. Patterns target the timestamp-/UUID-prefixed
# names the server generates, so committed default assets (avatar-NN.svg,
# party/venue/*.jpg, etc.) stay tracked.
public/assets/avatars/user-*
public/assets/party/[0-9]*-*
public/assets/products/
public/assets/content/
public/assets/responsive-screenshots/

# Bookkeeping fylgiskjol (receipts, supplier invoices) — private upload root,
# never statically served. Local-disk fallback for BOOKS_UPLOAD_ROOT.
private-uploads/

# site-factory
data/import/

# Company/business docs — belong in the future orange-smiley/company repo, not the website repo
company/

# Iceland scene source photos (originals; only generated derivatives ship)
assets-src/
