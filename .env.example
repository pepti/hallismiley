# ══════════════════════════════════════════════════════════════════════════════
# Halli Smiley (the HalliProjects base) — environment variables
# Copy this file to .env and fill in all required values before deploying.
# Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# In production this points at Azure Database for PostgreSQL Flexible Server
# (e.g. postgresql://<admin>:<url-encoded-pw>@<server>.postgres.database.azure.com:5432/<dbname>?sslmode=require).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated list of origins allowed to make cross-origin requests.
# Must exactly match the protocol+host+port of your frontend (no trailing slash).
# Example: https://hallismiley.is,https://www.hallismiley.is
ALLOWED_ORIGINS=

# Node environment. Set to "production" for live deployments.
# Controls secure cookies, Sentry sample rates, and other prod-only behaviour.
NODE_ENV=production

# Random 32+ character secret for CSRF double-submit cookie signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the HTTP server listens on. Azure App Service sets this automatically
# (PORT=8080 for Linux containers).
# Default: 3000
PORT=3000

# Pino log level. Use "debug" for troubleshooting; keep "info" in production.
# Levels: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info

# Sentry project DSN for error tracking and performance monitoring.
# Leave blank to disable Sentry entirely.
# Example: https://abc123@o0.ingest.sentry.io/123456
SENTRY_DSN=

# Bearer token required to access GET /metrics (Prometheus endpoint).
# If blank, /metrics is only accessible from localhost.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
METRICS_TOKEN=

# Webhook URL for critical alert notifications (Slack, Discord, PagerDuty).
# Leave blank to disable webhook alerts.
# Example: https://hooks.slack.com/services/T00/B00/xxxx
ALERT_WEBHOOK_URL=

# PostgreSQL TLS. ON by default when NODE_ENV=production (server/config/database.js);
# "true" forces it on anywhere, "false" is an explicit opt-out for a database with no
# TLS (never Azure — it requires TLS). Unset = off in development.
DB_SSL=true

# ── Uploads ───────────────────────────────────────────────────────────────────

# Root for public uploads (product photos, avatars, news media). REQUIRED in
# production — server/config/paths.js refuses to boot without it; in development
# it defaults to public/assets. On Azure this is the Azure Files mount.
# UPLOAD_ROOT=/app/uploads

# Root for the books' supporting documents (fylgiskjöl). Served only by an
# authenticated streaming route. Defaults to private-uploads/books INSIDE the
# repo (gitignored) — for real books point it OUTSIDE the checkout, on a disk
# you back up (bókhaldslög 145/1994 gr. 20, seven years).
# BOOKS_UPLOAD_ROOT=/var/lib/hallismiley/books

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Transactional email goes through Resend (server/services/emailService.js).
# Leave the key blank to skip sends entirely (dev/test). REQUIRED for boot when
# APP_ENV=production (server/server.js). There are no SMTP settings — SMTP_USER
# / SMTP_PASS were listed here until 2026-09-12 and nothing read them.
RESEND_API_KEY=

# From address for transactional email. Defaults to halli@hallismiley.is; must
# be a sender Resend has verified for the domain.
# EMAIL_FROM=halli@hallismiley.is

# ── Environment label ─────────────────────────────────────────────────────────
# APP_ENV is the deployment's own label (server/middleware/ssrMeta.js semantics: only
# 'test' and 'development' count as "not the live site"; anything else, or
# unset, is production). NODE_ENV is 'production' on every deployed container,
# TEST stacks included, so a TEST stack sets APP_ENV=test. Setting
# APP_ENV=production makes RESEND_API_KEY boot-fatal. Never set APP_ENV=test on
# the live site — it switches on the TEST chrome and the change-request widget.
# APP_ENV=production

# Optional: inbox that receives the party "request to join" notifications. It is
# ALWAYS notified (in addition to any verified admin accounts), so requests reach
# you even when no admin email is verified. Defaults to halli@hallismiley.is.
# PARTY_NOTIFY_EMAIL=halli@hallismiley.is

# Public base URL used to build verification and reset links in emails.
# Must match the URL users actually visit (no trailing slash).
APP_URL=https://www.hallismiley.is

# ── Google Sign-In (OAuth 2.0 + PKCE) ─────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# (type: Web application). Leave blank to disable Google sign-in entirely —
# the button will 500 if clicked without these set.
#
# Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below. In
# dev, add http://localhost:3000/auth/google/callback to Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.hallismiley.is/auth/google/callback

# ── Facebook Sign-In (OAuth 2.0, no PKCE) ─────────────────────────────────────
# Create an app at https://developers.facebook.com/apps/
# Add the "Facebook Login" product, then set the OAuth redirect URI below.
# App must be in "Live" mode for non-admin users to log in.
# Leave blank to disable Facebook sign-in (the button will error if clicked).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://www.hallismiley.is/auth/facebook/callback

# ── Auto-translation (EN → IS on admin save) ─────────────────────────────────
# Feature flag. Set to "true" to enable server-side Anthropic translation of
# empty IS fields when an admin saves English content. Leave blank/false to
# keep the feature dark (all saves behave exactly as they do today).
TRANSLATE_ENABLED=

# Anthropic API key. Required when TRANSLATE_ENABLED=true. Leave blank to
# hard-disable translation even if the flag is on.
ANTHROPIC_API_KEY=

# Optional: model override. Defaults to claude-haiku-4-5.
# TRANSLATE_MODEL=claude-haiku-4-5

# Optional: per-call timeout in milliseconds. Defaults to 8000 (8s).
# On timeout, the save still succeeds — only the IS field stays null.
# TRANSLATE_TIMEOUT_MS=8000

# ── Search engine verification & instant indexing ─────────────────────────────

# Bing Webmaster Tools verification token. Obtained at
# https://www.bing.com/webmasters after adding the property and choosing the
# meta-tag verification method. The server injects it into <meta name="msvalidate.01">.
# Leave blank until you have a real token — empty content is harmless.
BING_VERIFICATION_TOKEN=

# Google Search Console verification token. Obtained at
# https://search.google.com/search-console after adding the property. The
# server injects it into <meta name="google-site-verification">.
GOOGLE_VERIFICATION_TOKEN=

# IndexNow API key — Bing/Yandex/Seznam re-crawl any URL we POST to
# https://api.indexnow.org/IndexNow within minutes. Required for the
# fire-and-forget submitToIndexNow() calls in server/services/indexNow.js.
# Generate a 32-char hex key (e.g. with `(New-Guid).Guid -replace '-',''`)
# and paste the same value into Bing Webmaster Tools → IndexNow. The server
# also serves it at https://www.hallismiley.is/<KEY>.txt for ownership proof.
# Leave blank in dev — IndexNow calls are silently skipped when unset.
INDEXNOW_KEY=


# ── Locale ────────────────────────────────────────────────────────────────────
# Content-fallback locale dimension (server/config/i18n.js). Leave unset unless
# you know why you're changing it — visitor-facing default is configured in code.
# DEFAULT_LOCALE=en

# ── Per-instance client config (server/config/clientConfig.js) ────────────────
# Which modules this instance exposes and how they behave lives in the
# file config/client.json — which the BASE does not have (it runs on the schema
# defaults; instances add the file at scaffold time). Any single key can be overridden per
# deployment with a CLIENT_CONFIG_* variable, whose name is the config path in
# upper snake case — these win over the file. NO SECRETS: the resolved config
# is pino-logged in full at boot.
#
#   CLIENT_CONFIG_MODULES_SELF_UPDATE_MODE=managed        # managed|auto|manual
#   CLIENT_CONFIG_MODULES_SELF_UPDATE_CHANNEL=stable      # stable|canary
#   CLIENT_CONFIG_MODULES_SELF_UPDATE_MANIFEST_URL=https://releases.orangesmiley.is/store/{channel}.json
#   CLIENT_CONFIG_MODULES_SELF_UPDATE_MAINTENANCE_WINDOW_DAYS=tue,wed,thu
#   CLIENT_CONFIG_MODULES_SELF_UPDATE_MAINTENANCE_WINDOW_FROM_HOUR=3
#   CLIENT_CONFIG_MODULES_SELF_UPDATE_MAINTENANCE_WINDOW_TO_HOUR=5
#   CLIENT_CONFIG_MODULES_SELF_UPDATE_MAINTENANCE_WINDOW_TZ=Atlantic/Reykjavik
#
# Relocates the JSON file itself (tests use it; leave unset in deployments).
# CLIENT_CONFIG_FILE=

# ── Dark-by-default switches (read by code; unset = off) ──────────────────────
# MCP connector (docs/mcp.md): endpoint answers 404 until this is "true".
# MCP_ENABLED=
# MCP_ALLOWED_SCOPES=read
# MCP_TOKEN_TTL_DAYS=90
# MCP_RATE_LIMIT_MAX=300
# Google/Facebook sign-in routes answer 404 unless this is "true".
# SOCIAL_LOGIN_ENABLED=
# Storefront on/off.
# SHOP_ENABLED=
# Comma-separated hosts the outbound allowlist admits beyond the manifest host.
# OUTBOUND_ALLOWED_HOSTS=
# Only these recipients receive mail when set (a TEST-stack guard).
# EMAIL_ALLOWLIST=
# Self-update: the platform deployment webhook the applier POSTs to
# (docs/SELF-UPDATE.md); without it an update can be recorded, not applied.
# SELF_UPDATE_TRIGGER_URL=
# event_logs retention for the daily prune (default 90).
# EVENT_LOG_RETENTION_DAYS=90

# ── Stripe (shop checkout) ────────────────────────────────────────────────────
# Required for checkout/webhooks (server/config/stripe.js, stripeService.js).
# Leave blank to keep the shop browsable; checkout endpoints error until set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
